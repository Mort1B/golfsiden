FROM rust:1.88-bookworm AS builder

WORKDIR /source
COPY Cargo.toml Cargo.lock ./
COPY vendor/sqlx-core vendor/sqlx-core
COPY vendor/sqlx-postgres vendor/sqlx-postgres
COPY backend/Cargo.toml backend/Cargo.toml
COPY migrations migrations
COPY backend backend
RUN cargo build --locked --release -p golf-api --bins

FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587 AS runtime

RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 golf
COPY --from=builder /source/target/release/golf-api /usr/local/bin/golf-api
COPY --from=builder /source/target/release/migrate /usr/local/bin/migrate
COPY --from=builder /source/target/release/password-recovery /usr/local/bin/password-recovery

USER golf
EXPOSE 3000
ENTRYPOINT ["/usr/local/bin/golf-api"]
