{
  "name": "golf-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser:lifecycle": "playwright test --config playwright.lifecycle.config.ts",
    "test:browser:rounds": "playwright test --config playwright.lifecycle.config.ts roundDetails.browser.ts",
    "test:browser:progress": "playwright test --config playwright.lifecycle.config.ts flightProgress.browser.ts",
    "test:browser:completion": "playwright test --config playwright.lifecycle.config.ts tournamentCompletion.browser.ts",
    "test:browser:archive": "playwright test --config playwright.lifecycle.config.ts tournamentArchive.browser.ts",
    "test:browser:courses": "playwright test --config playwright.lifecycle.config.ts coursePresets.browser.ts",
    "test:browser:creation": "playwright test --config playwright.lifecycle.config.ts tournamentCreation.browser.ts",
    "test:browser:leaderboards": "playwright test --config playwright.lifecycle.config.ts leaderboardLive.browser.ts",
    "test:browser:profile": "playwright test --config playwright.lifecycle.config.ts profile.browser.ts",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.84.1",
    "lucide-react": "^0.536.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
