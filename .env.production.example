# Copy to an untracked file outside Git and set mode 600.
SITE_ADDRESS=golf.example.com
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
GOLFSIDEN_IMAGE_TAG=replace-with-release-git-sha
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
PROXY_SHARED_SECRET=replace-me

POSTGRES_DB=golfsiden
POSTGRES_OWNER_USER=golfsiden_owner
# Use distinct URL-safe random values of at least 24 characters.
POSTGRES_OWNER_PASSWORD=replace-with-url-safe-random-owner-password
APP_DATABASE_USER=golfsiden_app
APP_DATABASE_PASSWORD=replace-with-url-safe-random-app-password

# Keep these URLs consistent with the role values above. Percent-encode any
# reserved URL characters in passwords; URL-safe random passwords are simpler.
MIGRATION_DATABASE_URL=postgres://golfsiden_owner:replace-with-url-safe-random-owner-password@postgres:5432/golfsiden
APP_DATABASE_URL=postgres://golfsiden_app:replace-with-url-safe-random-app-password@postgres:5432/golfsiden

DATABASE_MAX_CONNECTIONS=10
SESSION_TTL_HOURS=24
GOLF_COURSE_API_DAILY_LIMIT=50
# GOLF_COURSE_API_KEY=
RUST_LOG=golf_api=info,tower_http=info
